# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# The site URL as it appears in Search Console
# Use the exact URL prefix, e.g. https://thesalesguy.com.au/ (trailing slash matters)
SITE_URL=https://thesalesguy.com.au/

# GA4 numeric Property ID (NOT the G-XXXXXXXX measurement ID)
# Find it in GA4 Admin > Property Settings > Property ID
GA4_PROPERTY_ID=123456789
